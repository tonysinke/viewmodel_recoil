<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>VMRecoil</AssemblyName>
    <RootNamespace>VMRecoil</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591;CS8632</NoWarn>

    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>

    <!--
      默认走 NuGet 上的 CounterStrikeSharp.API。
      如需改用本地服务器自带的 API dll：
        dotnet build -p:CssApiDir="D:\你的服务器\game\csgo\addons\counterstrikesharp\api"
    -->
    <CssApiVersion Condition="'$(CssApiVersion)' == ''">1.0.284</CssApiVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(CssApiDir)' == ''">
    <PackageReference Include="CounterStrikeSharp.API" Version="$(CssApiVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(CssApiDir)' != ''">
    <Reference Include="CounterStrikeSharp.API">
      <HintPath>$(CssApiDir)\CounterStrikeSharp.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
